{
  "manifest_version": 3,
  "name": "Ortus Club · HubSpot Sync New",
  "version": "0.1.60",
  "description": "Lookup or push the LinkedIn profile you're viewing into Ortus Club's HubSpot.",
  "update_url": "https://ortusclub.github.io/ortus-hs-ext/updates.xml",
  "key": "",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://ortusclub.github.io/*",
    "https://ortus-hs-proxy.ortus-eb6.workers.dev/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16":  "icons/hs-16.png",
    "32":  "icons/hs-32.png",
    "48":  "icons/hs-48.png",
    "128": "icons/hs-128.png"
  },
  "action": {
    "default_icon": {
      "16":  "icons/hs-16.png",
      "32":  "icons/hs-32.png",
      "48":  "icons/hs-48.png",
      "128": "icons/hs-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["salesNavApi.js", "scraper.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
